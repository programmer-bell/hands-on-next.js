# ─────────────────────────────────────────────────────────────
# .env.docker.example — Template for Docker env configuration
# Copy this to .env.production and customize for your deploy
# ─────────────────────────────────────────────────────────────

# ─── Build-time variables (NEXT_PUBLIC_*) ────────────────────
# These are inlined into the JS bundle during `next build`.
# Changing them requires a full image rebuild.
NEXT_PUBLIC_APP_NAME="Analytics"
NEXT_PUBLIC_POLL_INTERVAL_ACTIVITY=3000
NEXT_PUBLIC_POLL_INTERVAL_PERFORMANCE=3000
NEXT_PUBLIC_POLL_INTERVAL_REVENUE=10000
NEXT_PUBLIC_POLL_INTERVAL_OVERVIEW=15000

# ─── Runtime variables ──────────────────────────────────────
# These can be changed without rebuilding the image.
NODE_ENV=production
PORT=3000

# ─── Secrets (never commit real values!) ─────────────────────
# DATABASE_URL=postgres://user:pass@host:5432/db
# API_SECRET_KEY=change-me
